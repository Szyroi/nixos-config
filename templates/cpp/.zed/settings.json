{
  "languages": {
    "C++": {
      "language_servers": [
        "clangd"
      ],
      "format_on_save": "on"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--compile-commands-dir=build"
        ]
      },
      "initialization_options": {
        "fallbackFlags": [
          "-std=c++23"
        ]
      }
    }
  }
}
